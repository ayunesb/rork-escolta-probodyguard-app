rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidImageFile() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocumentFile() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }
    
    function isValidSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }
    
    match /documents/{userId}/{document} {
      // El dueno siempre puede ver sus propios documentos. Admin revisa KYC
      // de cualquiera; una empresa solo revisa los de SUS escoltas
      // (companyId == su uid), mismo patron que ya usan firestore.rules y
      // database.rules.json para /users y /bookings.
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'company' &&
         firestore.get(/databases/(default)/documents/users/$(userId)).data.companyId == request.auth.uid)
      );

      // El dueno siempre puede subir los suyos; admin o la empresa dueña de
      // ese escolta (companyId == su uid) tambien, para poder llenar la
      // documentacion completa del personal en su nombre.
      allow write: if isAuthenticated() &&
                     isValidDocumentFile() &&
                     isValidSize(5) && (
                       isOwner(userId) ||
                       firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
                       (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'company' &&
                        firestore.get(/databases/(default)/documents/users/$(userId)).data.companyId == request.auth.uid)
                     );
    }

    match /photos/{userId}/{photo} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
                     isValidImageFile() &&
                     isValidSize(5) && (
                       isOwner(userId) ||
                       firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
                       (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'company' &&
                        firestore.get(/databases/(default)/documents/users/$(userId)).data.companyId == request.auth.uid)
                     );
    }
    
    match /bookings/{bookingId}/{file} {
      allow read: if isAuthenticated();
      
      allow write: if isAuthenticated() &&
                     isValidImageFile() &&
                     isValidSize(10);
    }
  }
}
