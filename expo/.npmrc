# lucide-react-native@0.475 declara peer react <=18, pero el proyecto usa React 19.
# El componente funciona; solo el rango declarado esta desactualizado.
#
# El vercel.json ya pasa --legacy-peer-deps al install principal, pero Vercel
# lanza una SEGUNDA instalacion por su cuenta para compilar api/stripe/, y esa
# no hereda installCommand. Puesto aqui, aplica a todas.
legacy-peer-deps=true
