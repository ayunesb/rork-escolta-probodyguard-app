rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidImageFile() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocumentFile() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }
    
    function isValidSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }
    
    // firestore.get() cruzado desde Storage Rules NO funciona en este
    // proyecto (probado en vivo: hasta el caso mas simple posible, sin
    // ninguna otra condicion, devuelve 403 para un admin real leyendo su
    // propio documento — no es un problema de logica de la regla, es una
    // limitacion/permiso de infraestructura de este proyecto de GCP, fuera
    // de lo que se puede arreglar desde aqui). Por eso esta regla NO llama a
    // firestore.get() en ningun lado: el "dueno" del documento se codifica
    // directo en la ruta como {scopeId}, que es el companyId del escolta si
    // pertenece a una empresa, o su propio uid si es independiente. Asi la
    // empresa puede subir/ver los documentos de SU escolta sin que la regla
    // necesite consultar Firestore para saberlo.
    match /documents/{scopeId}/{userId}/{document} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == scopeId);

      allow write: if isAuthenticated() &&
                     (request.auth.uid == userId || request.auth.uid == scopeId) &&
                     isValidDocumentFile() &&
                     isValidSize(5);
    }

    match /photos/{scopeId}/{userId}/{photo} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
                     (request.auth.uid == userId || request.auth.uid == scopeId) &&
                     isValidImageFile() &&
                     isValidSize(5);
    }

    match /bookings/{bookingId}/{file} {
      allow read: if isAuthenticated();
      
      allow write: if isAuthenticated() &&
                     isValidImageFile() &&
                     isValidSize(10);
    }
  }
}
