# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Braintree Configuration (Backend Only - Never expose private key)
BRAINTREE_ENV=production
BRAINTREE_MERCHANT_ID=your_merchant_id
BRAINTREE_PUBLIC_KEY=your_public_key
BRAINTREE_PRIVATE_KEY=your_private_key

# Braintree Client Configuration (Safe to expose)
EXPO_PUBLIC_BRAINTREE_ENV=production
EXPO_PUBLIC_BRAINTREE_TOKENIZATION_KEY=your_tokenization_key
PAYMENTS_CURRENCY=MXN

# Backend Configuration
EXPO_PUBLIC_API_URL=http://localhost:8081
EXPO_PUBLIC_ALLOW_UNVERIFIED_LOGIN=0

# Monitoring & Security Configuration
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_url
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=your_debug_token_for_development
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
EXPO_PUBLIC_ENABLE_APP_CHECK=true
EXPO_PUBLIC_RORK_API_BASE_URL=https://your-api-url.com

# Optional: Google Maps (for enhanced map features)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: Sentry (for error tracking)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Optional: Analytics
EXPO_PUBLIC_ANALYTICS_ID=your_analytics_id

# === CUENTAS DEMO ===
# Las contrasenas demo ya NO viven en el codigo: este repositorio es publico y
# cualquiera que lo leyera tenia las cuatro cuentas, incluida la de admin.
# Se definen aqui en tu .env local (que no se sube) y en el entorno de las
# Cloud Functions. Minimo 12 caracteres, y NO reutilices las viejas: siguen
# en el historial publico de git y hay que darlas por quemadas.

# Precarga la pantalla de acceso, solo en desarrollo. Dejalas vacias y no
# precarga nada.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=

# Entorno de las Cloud Functions (sembrador y reseteo de cuentas demo).
DEMO_PASS_CLIENT=
DEMO_PASS_ADMIN=
DEMO_PASS_COMPANY=
DEMO_PASS_GUARD=
DEMO_PASS_SEED=

# Interruptor del reseteo de cuentas demo. Sin esto en 'true', la funcion
# resetDemoPasswords se niega a correr aunque quien llame sea administrador.
PERMITIR_RESET_DEMO=

# === STRIPE ===
# La llave publicable va en el navegador por diseno; la SECRETA jamas.
# La secreta se configura SOLO en las variables de entorno de Vercel, con el
# nombre STRIPE_SECRET_KEY, y nunca lleva el prefijo EXPO_PUBLIC_.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# A donde pedir el intento de pago. Es la URL de tu proyecto en Vercel, por
# ejemplo https://escolta-pro.vercel.app  (sin barra al final).
# Si esta vacia, la app sigue usando Braintree.
EXPO_PUBLIC_PAYMENTS_API_URL=
