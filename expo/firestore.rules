rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDoc) ? get(userDoc).data : null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData() != null && getUserData().role == role;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isKYCApproved() {
      return isAuthenticated() && getUserData() != null && getUserData().kycStatus == 'approved';
    }

    // === USERS COLLECTION ===
    match /users/{userId} {
    // `read` cubre get y list en una sola regla. Una consulta que un usuario
    // hace sobre su propio documento pasa; una lista sin filtro solo la
    // permiten admin y empresa. Antes eran dos reglas y la de `list` decia
    // `if isAuthenticated()`, o sea que cualquier registrado descargaba el
    // padron completo. Se comprobo en vivo: un cliente veia los 8 usuarios.
    // Este es el mismo patron que usa /bookings mas abajo: la empresa solo
    // lee SUS escoltas (companyId == su uid), no el padron completo. Antes
    // `hasRole('company')` bastaba sola, y cualquier empresa listaba a los
    // clientes y escoltas de las demas.
    //
    // El perfil de un escolta (role == 'guard') si es publico para cualquier
    // autenticado: un cliente tiene que poder listarlos y ver el detalle
    // antes de reservar. Sin esto la pantalla de "Book Protection" no tiene
    // forma de mostrar escoltas reales — por eso seguia mostrando datos de
    // mocks/guards.ts.
    allow read: if isAuthenticated() && (
      request.auth.uid == userId ||
      hasRole('admin') ||
      resource.data.role == 'guard' ||
      (hasRole('company') && resource.data.companyId == request.auth.uid)
    );
      
      // Allow users to create their own document with minimum required fields
      // This is critical for new user sign-up flow
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        request.resource.data.keys().hasAll(['email', 'role', 'firstName', 'lastName', 'phone', 'language', 'kycStatus', 'createdAt', 'isActive', 'emailVerified', 'updatedAt']);
      
      // Allow update: user can update own document, or admin can update any
      // Use direct check instead of hasRole() for self-updates to avoid recursion
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      
      // Allow delete only for admins
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // === BOOKINGS COLLECTION ===
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.guardId == request.auth.uid ||
        hasRole('admin') ||
        (hasRole('company') && get(/databases/$(database)/documents/users/$(resource.data.guardId)).data.companyId == request.auth.uid)
      );
      
      // Allow creation if authenticated client or company and required fields exist
      allow create: if isAuthenticated() && (
        hasRole('client') || hasRole('company')
      ) && request.resource.data.clientId == request.auth.uid &&
        request.resource.data.keys().hasAll(['clientId', 'guardId', 'status', 'createdAt']) &&
        request.resource.data.status is string &&
        request.resource.data.clientId is string &&
        request.resource.data.guardId is string;
      
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.guardId == request.auth.uid ||
        hasRole('admin') ||
        (hasRole('company') && get(/databases/$(database)/documents/users/$(resource.data.guardId)).data.companyId == request.auth.uid)
      );
      
      allow delete: if hasRole('admin');
    }

    // === MESSAGES COLLECTION ===
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.bookingId != null ||
        hasRole('admin')
      );
      
      // Allow creating messages if authenticated and sender is current user
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.bookingId is string &&
        request.resource.data.senderRole is string;
      
      allow update, delete: if false;
    }

    // === DOCUMENTS COLLECTION ===
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('admin')
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin') || isOwner(resource.data.userId);
    }

    // === EMERGENCY ALERTS COLLECTION ===
    match /emergencyAlerts/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasRole('admin') ||
        (exists(/databases/$(database)/documents/bookings/$(resource.data.bookingId)) &&
         (get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.guardId == request.auth.uid))
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if hasRole('admin') || isOwner(resource.data.userId);
      allow delete: if hasRole('admin');
    }

    // === PAYMENTS COLLECTION ===
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.guardId == request.auth.uid ||
        hasRole('admin')
      );
      // Allow clients to create their own payments
      allow create: if isAuthenticated() && (
        hasRole('client') && request.resource.data.clientId == request.auth.uid
      );
      // Allow updates from admins or the backend (for status updates)
      allow update: if hasRole('admin');
      allow delete: if false;
    }

    // === KYC AUDIT LOGS ===
    match /kycAuditLog/{logId} {
      allow read, create: if hasRole('admin');
      allow update, delete: if false;
    }

    // === RATE LIMITS ===
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // === SYSTEM LOGS ===
    match /logs/{logId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // === ERRORS ===
    match /errors/{errorId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // === ANALYTICS ===
    match /analytics/{eventId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // === PERFORMANCE ===
    match /performance/{metricId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // === WEBHOOK LOGS ===
    match /webhook_logs/{logId} {
      allow write: if request.auth == null ||
                   (request.auth.token.email_verified == false &&
                    request.auth.token.email.matches('.*@appspot.gserviceaccount.com$'));
      allow read: if hasRole('admin');
    }

    // === DEVICE TOKENS (Push Notifications) ===
    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('admin')
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // === NOTIFICATIONS ===
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('admin')
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // =========================================================================
    // Once colecciones que el cliente ya usaba y que nunca tuvieron reglas.
    // Sin bloque, Firestore niega por defecto: el pago al escolta, las
    // calificaciones, los reportes de incidente y el borrado de cuenta
    // estaban muertos en produccion. El patron es el mismo que /bookings:
    // `read` cubre get y list, asi una consulta filtrada por el dueno pasa
    // y una lista sin filtro se niega.
    // =========================================================================

    // === PAYOUTS: el pago al escolta ===
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        resource.data.guardId == request.auth.uid || hasRole('admin')
      );
      // El escolta solo puede pedir SU pago, y solo con KYC aprobado.
      // Aqui es donde isKYCApproved() deja de ser una funcion muerta.
      allow create: if isAuthenticated() &&
        request.resource.data.guardId == request.auth.uid &&
        isKYCApproved() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasAll(['guardId', 'amount', 'bookingIds', 'status', 'createdAt']);
      // Marcar un pago como completado es del administrador, no del cobrador.
      allow update: if hasRole('admin');
      allow delete: if false;
    }

    // === LEDGER: libro de ganancias del escolta ===
    match /ledger/{entryId} {
      allow read: if isAuthenticated() && (
        resource.data.guardId == request.auth.uid || hasRole('admin')
      );
      // Solo lectura para el escolta: no puede inventarse ganancias.
      allow create: if hasRole('admin');
      allow update, delete: if false;
    }

    // === REVIEWS: las escribe el cliente de esa reserva ===
    match /reviews/{reviewId} {
      // Legibles por cualquier usuario autenticado: son la reputacion publica
      // del escolta. Contienen clientId, asi que no se abren sin sesion.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.keys().hasAll(['bookingId', 'guardId', 'clientId', 'rating']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || hasRole('admin')
      );
      allow delete: if hasRole('admin');
    }

    // === INCIDENT REPORTS ===
    match /incidentReports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.reportedBy == request.auth.uid || hasRole('admin') || hasRole('company')
      );
      allow create: if isAuthenticated() &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.keys().hasAll(['bookingId', 'reportedBy', 'type', 'severity', 'status']);
      // Quien reporta puede completar su reporte; cerrarlo es del administrador.
      allow update: if isAuthenticated() && (
        resource.data.reportedBy == request.auth.uid || hasRole('admin')
      );
      allow delete: if false;
    }

    // === DELETION REQUESTS: obligacion legal, no funcion opcional ===
    match /deletion_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('admin')
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if hasRole('admin');
      allow delete: if false;
    }

    // === KYC AUDIT LOG: solo se agrega, nunca se edita ni se borra ===
    match /kyc_audit_log/{entryId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // === REFUNDS: solo administracion ===
    // backend/trpc/routes/payments/braintree/refund/route.ts los escribe con el
    // SDK de cliente. Si esa ruta no corre autenticada como admin va a seguir
    // fallando, y la solucion correcta es moverla a Cloud Functions con Admin
    // SDK, no abrir esta regla a cualquier usuario.
    match /refunds/{refundId} {
      allow read: if hasRole('admin');
      allow create: if hasRole('admin');
      allow update, delete: if false;
    }

    // === TYPING: indicador efimero de chat (id = bookingId_userId) ===
    match /typing/{typingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // === TELEMETRIA: la escribe el cliente, solo la lee el administrador ===
    match /usage_metrics/{metricId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /cost_alerts/{alertId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update: if hasRole('admin');
      allow delete: if false;
    }

    // Nota: el limitador de peticiones vive en el cliente, asi que este registro
    // es evidencia, no un control. Un control real va en Cloud Functions.
    match /rateLimitViolations/{violationId} {
      allow read: if hasRole('admin');
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // === DEFAULT DENY ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
